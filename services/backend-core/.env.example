# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<AppName>
MONGO_DB_NAME=mindtrace_ai

# JWT
JWT_SECRET=<generate-a-secure-256-bit-hex-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# AI Configuration
USE_REAL_MODEL=true
HF_MODEL_NAME=j-hartmann/emotion-english-distilroberta-base

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@mindtrace.ai
SMTP_PASS=<your-smtp-password>

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false
